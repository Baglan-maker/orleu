# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/orleu_db

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
APP_NAME=Orleu

# OpenRouter (LLM for coach messages). Optional — leave empty to use templates only.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b:free
OPENROUTER_TIMEOUT_S=10.0

# Admin dashboard (/admin/ml-health). Leave empty to disable.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Sentry error tracking. Leave empty to disable. Get DSN from sentry.io project settings.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
